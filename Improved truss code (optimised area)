import cvxpy as cp
import numpy as np
import matplotlib.pyplot as plt


# DEFINE STRUCTURE GEOMETRY

# Node data, this is array layout -> [x(mm), y(mm), x_support, y_support, x_force(kN), y_force(kN)]
nodes = np.array([
    [0, 0, 1, 1, 0, 0],       # Node 0: Left support (pinned)
    [7000, 0, 0, 1, 0, 0],    # Node 1
    [14000, 0, 0, 0, 0, 0],   # Node 2
    [21000, 0, 0, 1, 0, 0],   # Node 3: Middle support (roller)
    [28000, 0, 0, 0, 0, 0],   # Node 4
    [35000, 0, 0, 1, 0, 0],   # Node 5
    [42000, 0, 1, 1, 0, 0],   # Node 6: Right support (pinned)
    

    [0, 3400, 0, 0, 0, -2250],    # Node 7: End load ( F/2)
    [7000, 3400, 0, 0, 0, -4500], # Node 8: 
    [14000, 3400, 0, 0, 0, -4500],# Node 9
    [21000, 3400, 0, 0, 0, -4500],# Node 10
    [28000, 3400, 0, 0, 0, -4500],# Node 11
    [35000, 3400, 0, 0, 0, -4500],# Node 12
    [42000, 3400, 0, 0, 0, -2250] # Node 13: End load (F/2)
])

# Extract node components from nodes array
Coords = nodes[:, 0:2]        # Node coordinates [mm]
dof_status = nodes[:, 2:4]    # Support conditions (1=fixed, 0=free)
forces = nodes[:, 4:6]        # Applied forces [kN]

# ELEMENT CONNECTIVITY: [ start node, end node, crosssectional area (mm²)]
elements = np.array([
    # Bottom chord elements (0-5)
    [0, 1, 37400], [1, 2, 37400], [2, 3, 37400],
    [3, 4, 37400], [4, 5, 37400], [5, 6, 37400],
    
    # Vertical elements (6-12)
    [0, 7, 37400], [1, 8, 37400], [2, 9, 37400],
    [3, 10, 37400], [4, 11, 37400], [5, 12, 37400], [6, 13, 37400],
    
    # Top chord elements (13-18)
    [7, 8, 37400], [8, 9, 37400], [9, 10, 37400],
    [10, 11, 37400], [11, 12, 37400], [12, 13, 37400],
    
    # Diagonal elements (19-24)
    [0, 8, 37400], [8, 2, 37400], [2, 10, 37400],
    [10, 4, 37400], [4, 12, 37400], [12, 6, 37400]
])

ElmCon = elements[:, 0:2].astype(int)  # Element connectivity
yieldStress = 0.355                    # Plastic yield stress [kN/mm²] (355 MPa)
num_of_nodes = len(nodes)              # Total number of nodes
num_of_elements = len(elements)        # Total number of elements


# BUILD EQUILIBRIUM MATRIX (B)


lengths = np.zeros(num_of_elements)    # To store the lengths after 
B = np.zeros([2 * num_of_nodes, num_of_elements])  # zero matrix for equilibrium matrix

for i in range(num_of_elements):
    startNode, endNode = ElmCon[i]
    x0, y0 = Coords[ startNode]
    x1, y1 = Coords[endNode]
     
    
    # Calculate member length and direction cos abd sin 
    lengths[i] = np.sqrt((x1 - x0)**2 + (y1 - y0)**2)
    c = (x1 - x0)/lengths[i]  # Cos of angle
    s = (y1 - y0)/lengths[i]  # Sin of angle
    
    # Fill the equilibrium matrix
    rows = [2*startNode, 2*startNode+1, 2*endNode, 2*endNode+1]
    B[rows, i] = [c, s, -c, -s]

# 3. APPLY BOUNDARY CONDITIONS

# Convert forces and supports to 1D matrixes 
F = forces.reshape([-1])                # Flattened forces
dof_status_1D = dof_status.reshape([-1]) # Flattened dof matrix

# Identify free degrees of freedom
freedof = np.where(dof_status_1D == 0)[0]
f_reduced = F[freedof]                  # Forces at free DOFs
B_reduced = B[freedof]                  # Equilibrium matrix for free DOFs


#ITERATIVE AREA OPTIMIZATION (LOAD FACTOR ≥ 1)


# Define range of A values to test (in mm²)
A_values = np.linspace(1000, 50000, 100)  # <----- Change for better results
load_factors = []
valid_As = []
valid_lfs = []

for A_test in A_values:
    # change element areas
    a = np.array([A_test] * num_of_elements)
    
    # Set up and solve the optimization problem
    q = cp.Variable(num_of_elements)
    load_factor = cp.Variable(nonneg=True)
    
    yieldConstraints = [
        yieldStress * a - q >= 0,
        yieldStress * a + q >= 0
    ]
    
    equilibriumConstraints = [B_reduced @ q == -f_reduced * load_factor]
    prob = cp.Problem(cp.Maximize(load_factor),yieldConstraints + equilibriumConstraints)
    prob.solve()
    
    current_load_factor = load_factor.value
    load_factors.append(current_load_factor)
    
    #  Store solutions (load factor ≥ 1)
    if current_load_factor >= 1:
        valid_As.append(A_test)
        valid_lfs.append(current_load_factor)

# Find minimal area that satisfies LF≥ 1
if valid_As:
    optimal_A = min(valid_As)
    optimal_idx = A_values.tolist().index(optimal_A)
    
    # Recalculate with optimal A to get forces and stresses
    a_opt = np.array([optimal_A] *num_of_elements)
    q = cp.Variable(num_of_elements)
    load_factor = cp.Variable(nonneg=True)
    yieldConstraints = [
        yieldStress * a_opt - q >= 0,
        yieldStress * a_opt + q >= 0]
    equilibriumConstraints = [B_reduced @ q == -f_reduced * load_factor]
    prob = cp.Problem(cp.Maximize(load_factor), yieldConstraints + equilibriumConstraints)
    prob.solve()
    
    optimal_forces = q.value
    optimal_stresses = optimal_forces / a_opt
    achieved_lf = load_factor.value


# RESULTS AND VISUALIZATION


print(f"\nMINIMAL CROSS-SECTIONAL AREA WITH LF ≥ 1: {optimal_A:.1f} mm²")
print(f"Achieved load factor: {achieved_lf:.3f}")

# Plot for the load factor vs area graph 
plt.figure(figsize=(10, 5))
plt.plot(A_values,load_factors, 'b-', label='load Factor vs Area')
plt.axhline(y=1, color='r', linestyle='--', label='Target load factor (LF=1)')
plt.axvline(x=optimal_A, color='g', linestyle=':',label=f'Optimal Area ({optimal_A:.1f} mm²)')
plt.xlabel('Cross-sectional Area (mm²)')
plt.ylabel('Load Factor')
plt.title('Load Factor vs Cross-sectional Area')
plt.legend()
plt.grid(True)
plt.show()

# Graph of truss to show stresses
fig, ax = plt.subplots(figsize=(14, 5))
ax.set_aspect('equal')
ax.set_title(f"Optimal Truss Design (A = {optimal_A:.1f} mm²)", fontweight='bold')
ax.set_xlabel("X [mm]")
ax.set_ylabel("Y [mm]")
plt.grid(True, linestyle=':', alpha=0.7)

for i in range(num_of_elements):
    n1, n2 = ElmCon[i]
    x0, y0 = Coords[n1]
    x1, y1 = Coords[n2]
    
    mid_x = (x0 + x1)/2
    mid_y = (y0 + y1)/2
    dx = (y1 - y0)/lengths[i] * 200
    dy = -(x1 - x0)/lengths[i] * 200
    
    stress = optimal_stresses[i]
    
    # color coding for the elements : blue=tension, red=compression
    if stress >= 1e-3:
        color = 'blue'
        force_type = "T"
    elif stress <= -1e-3:
        color = 'red'
        force_type = "C"
    else:
        color = 'black'
        force_type = "N"
    
    ax.plot([x0, x1], [y0, y1], color=color, linewidth=2)
    
    if abs(stress) > 0.01:
        label = f"{stress:.3f} ({force_type})"
        ax.text(mid_x + dx, mid_y + dy, label,
                fontsize=8, color=color, ha='center',va='center',
                bbox=dict(facecolor='white', edgecolor='none', alpha=0.7))

ax.scatter (Coords[:, 0], Coords[:, 1], color='black', s=30,zorder=3)
ax.legend(handles=[
    plt.Line2D([0], [0],color='blue', lw=2, label='Tension'),
    plt.Line2D([0], [0], color='red', lw=2, label='Compression')
], loc='upper right')


plt.tight_layout()
plt.show()

# Print detailed results
print("\n=== RESULTS FOR OPTIMAL AREA ===")
for i in range(num_of_elements):
    print(f'Element {i:2d}: Force = {optimal_forces[i]:7.1f} kN, Stress = {optimal_stresses[i]:6.3f} kN/mm²')
