
import cvxpy as cp  
import numpy as np
import matplotlib.pyplot as plt

# DEFINE STRUCTURE GEOMETRY


# NODE DATA: [x(mm), y(mm), x_support, y_support, x_force(kN), y_force(kN)]
nodes = np.array([
    # Bottom chord nodes (0-6)
    [0, 0, 1, 1, 0, 0],       # Node 0: Left support (pinned)
    [7000, 0, 0, 0, 0, 0],    # Node 1
    [14000, 0, 0, 0, 0, 0],   # Node 2
    [21000, 0, 0, 1, 0, 0],   # Node 3: Middle support (roller)
    [28000, 0, 0, 0, 0, 0],   # Node 4
    [35000, 0, 0, 0, 0, 0],   # Node 5
    [42000, 0, 1, 1, 0, 0],   # Node 6: Right support (pinned)
    
    # Top chord nodes (7-13) with vertical loads
    [0, 3400, 0, 0, 0, -2250],    # Node 7: End load (F/2)
    [7000, 3400, 0, 0, 0, -4500], # Node 8: 
    [14000, 3400, 0, 0, 0, -4500],# Node 9
    [21000, 3400, 0, 0, 0, -4500],# Node 10
    [28000, 3400, 0, 0, 0, -4500],# Node 11
    [35000, 3400, 0, 0, 0, -4500],# Node 12
    [42000, 3400, 0, 0, 0, -2250] # Node 13: End load (F/2)
])

# Extract node components
Coords = nodes[:, 0:2]        # Node coordinates [mm]
dof_status = nodes[:, 2:4]    # Support conditions (1=fixed, 0=free)
forces = nodes[:, 4:6]        # Applied forces [kN]

# ELEMENT CONNECTIVITY: [start node, end node, cross-sectional area (mm²)]
elements = np.array([
    # Bottom chord elements (0-5)
    [0, 1, 37400], [1, 2, 37400], [2, 3, 37400],
    [3, 4, 37400], [4, 5, 37400], [5, 6, 37400],
    
    # Vertical elements (6-12)
    [0, 7, 37400], [1, 8, 37400], [2, 9, 37400],
    [3, 10, 37400], [4, 11, 37400], [5, 12, 37400], [6, 13, 37400],
    
    # Top chord elements (13-18)
    [7, 8, 37400], [8, 9, 37400], [9, 10, 37400],
    [10, 11, 37400], [11, 12, 37400], [12, 13, 37400],
    
    # Diagonal elements (19-24)
    [0, 8, 37400], [8, 2, 37400], [2, 10, 37400],
    [10, 4, 37400], [4, 12, 37400], [12, 6, 37400]
])

ElmCon = elements[:, 0:2].astype(int)  # Element connectivity
a = elements[:, 2]                     # Cross-sectional areas [mm²]
yieldStress = 0.355                    # Plastic yield stress [kN/mm²] (355 MPa)

num_of_nodes = len(nodes)              # Total number of nodes
num_of_elements = len(elements)        # Total number of elements


# SET UP OPTIMIZATION PROBLEM


# Optimization variables
q = cp.Variable(num_of_elements)       # Axial forces in members [kN]
load_factor = cp.Variable(nonneg=True) # Load multiplir

# Yield constraints 
yieldConstraints = [
    yieldStress * a - q >= 0,  # Compression limit
    yieldStress * a + q >= 0   # Tension limit
    ]

# BUILD EQUILIBRIUM MATRIX (B)

lengths = np.zeros(num_of_elements)    # To store the lengths after
B = np.zeros([2 * num_of_nodes, num_of_elements])  # Zero matrix for equlibrium matrix

for i in range(num_of_elements):
    startNode, endNode = ElmCon[i]
    x0, y0 = Coords[startNode]
    x1, y1 = Coords[endNode]
    
    # Calculate member length and direction cos abd sin
    lengths[i] = np.sqrt((x1 - x0)**2 + (y1 - y0)**2)
    c = (x1 - x0)/lengths[i]  # Cosine of angle
    s = (y1 - y0)/lengths[i]  # Sine of angle
    
    # Fill the equilibrium matrix
    rows = [2*startNode, 2*startNode+1, 2*endNode, 2*endNode+1]
    B[rows, i] = [c, s, -c, -s]

# APPLY BOUNDARY CONDITIONS

# Convert forces and supports to 1D matrixes
F = forces.reshape([-1])                # Flattened forces
dof_status_1D = dof_status.reshape([-1]) # Flattened dof matrix

# Identify free degrees of freedom 
freedof = np.where(dof_status_1D == 0)[0]
f_reduced = F[freedof]                  # Forces at free DOFs
B_reduced = B[freedof]                  # Equilibrium matrix for free DOFs


# SOLVE OPTIMIZATION PROBLEM


# Equilibrium constraints
equilibriumConstraints = [B_reduced @ q == -f_reduced * load_factor]

# Objective 
objective = cp.Maximize(load_factor)

# solve the problem
prob = cp.Problem(objective, yieldConstraints + equilibriumConstraints)
prob.solve()


# PRINT RESULTS


print("\n=== TRUSS ANALYSIS RESULTS ===")
for i in range(num_of_elements):
    force = q.value[i]
    stress = force/a[i]
    print(f'Element {i:2d}: Nodes {ElmCon[i]}, Force = {force:7.1f} kN, Stress = {stress:6.3f} kN/mm²')
print(f'\nMaximum Load Factor: {load_factor.value:.3f}')


# VISUALIZE RESULTS


fig, ax = plt.subplots(figsize=(14, 5))
ax.set_aspect('equal')
ax.set_title("Truss Analysis Results", fontweight='bold')
ax.set_xlabel("X [mm]")
ax.set_ylabel("Y [mm]")
plt.grid(True, linestyle=':', alpha=0.7)

# Color-coded stresses
for i in range(num_of_elements):
    n1, n2 = ElmCon[i]
    x0, y0 = Coords[n1]
    x1, y1 = Coords[n2]
    
    # stress labels coordinates
    mid_x = (x0 + x1)/2
    mid_y = (y0 + y1)/2
    
    # Text offset
    dx = (y1 - y0)/lengths[i] * 200   
    dy = -(x1 - x0)/lengths[i] * 200
    
    stress = q.value[i]/a[i]
    
    # Color coding (blue=tension, red=compression)
    if stress >= 1e-3:
        color = 'blue'
        force_type = "T"
    elif stress <= -1e-3:
        color = 'red'
        force_type = "C"
        
    else:
        color = 'black'
        force_type = "N"
    
    # Plot member
    ax.plot([x0, x1], [y0, y1], color=color, linewidth=2)
    
    # Label significant stresses
    if abs(stress) > 0.01:
        label = f"{stress:.3f} ({force_type})"
        ax.text(mid_x + dx, mid_y + dy, label,
                fontsize=8, color=color, ha='center', va='center',
                bbox=dict(facecolor='white', edgecolor='none', alpha=0.7))

# Plot nodes
ax.scatter(Coords[:, 0], Coords[:, 1], color='black', s=30, zorder=3)

# Add legend
legend_elements = [
    plt.Line2D([0], [0], color='blue', lw=2, label='Tension'),
    plt.Line2D([0], [0], color='red', lw=2, label='Compression')]
ax.legend(handles=legend_elements, loc='upper right')

plt.tight_layout()
plt.show()
